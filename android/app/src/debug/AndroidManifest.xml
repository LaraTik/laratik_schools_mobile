<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Debug builds apply the per-variant network security config that
      permits cleartext HTTP to the local dev backend (10.0.2.2 / LAN).
      tools:replace ensures the debug variant wins over the main manifest's
      networkSecurityConfig (which is HTTPS-only).
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
