# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock

# FVM (Flutter Version Management)
# .fvmrc is tracked (the version pin). The SDK cache and the per-project
# symlink to the cached version are per-machine and not tracked.
.fvm/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
*.lcov

# Test outputs
test/.test_session/
.dart_tool/test/

# Generated
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart

# Secrets
*.env
.env.local
*.keystore
*.jks
key.properties
google-services.json
firebase_options.dart

# Build artefacts
*.apk
*.aab
*.ipa
*.app
*.dSYM/
*.dSYM.zip
*.framework
*.app.zip

# --- Manual smoke-test screenshots (kept at repo root) ---
# mipmap-*/ic_launcher.png and android/app/src/main/res assets stay tracked.
/quiz_*.png
/after_*.png
/app_state*.png
/chrome_tab_state.png
/final_students.png
/login_state.png
/persistence_verified.png
/screencap.png
/select_menu.png
/state_check.png
/step_*.png
/student_detail*.png
/students_tab.png
/webview_state.png

# --- One-shot diagnostic scripts left in the repo root ---
/cdp_*.mjs
/bench_query.py
/check_users.py
/dump.py
/dump.sh
/dump_in.py
/q.sh
/run_query.sh
/check_site.ps1

# --- Android build noise that escapes android/.gitignore ---
android/.kotlin/

# --- Screenshot / artifact stash ---
# `docs/_artifacts/` is a home for transient screenshots, dumps, and
# diagnostic outputs. The directory itself is kept (so it shows up in
# `ls` and people can use it), but its contents are not tracked.
docs/_artifacts/*
