        "--dart-define=APP_FLAVOR=dev"
      ]
    },
    {
      "name": "Flutter: local (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "local",
        "--profile",
        "--dart-define=APP_FLAVOR=local"
      ]
    },
    {
      "name": "Flutter: qa (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "qa",
        "--profile",
        "--dart-define=APP_FLAVOR=qa"
      ]
    },
    {
      "name": "Flutter: prod (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "prod",
        "--profile",
        "--dart-define=APP_FLAVOR=prod"
      ]
    },
    {
      "name": "Flutter: dev (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "dev",
        "--release",
        "--dart-define=APP_FLAVOR=dev"
      ]
    },
    {
      "name": "Flutter: local (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "local",
        "--release",
        "--dart-define=APP_FLAVOR=local"
      ]
    },
    {
      "name": "Flutter: qa (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "qa",
        "--release",
        "--dart-define=APP_FLAVOR=qa"
      ]
    },
    {
      "name": "Flutter: prod (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor", "prod",
        "--release",
        "--dart-define=APP_FLAVOR=prod"
      ]
    },
    {
      "name": "Flutter: Attach",
      "request": "attach",
      "type": "dart",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Flutter: all flavors (debug)",
      "configurations": [
        "Flutter: dev (debug)",
        "Flutter: local (debug)",
        "Flutter: qa (debug)",
        "Flutter: prod (debug)"
      ]
    }
  ]
}
