{
  "dart.flutterSdkPath": ".fvm/versions/3.35.7",
  "dart.sdkPath": ".fvm/versions/3.35.7/bin/cache/dart-sdk",
  "dart.lineLength": 80,
  "dart.enableSdkFormatter": true,
  "dart.previewFlutterUiGuides": true,
  "dart.openDevTools": "never",
  "search.exclude": {
    "**/.fvm": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/Pods": true
  },
  "files.exclude": {
    "**/.fvm": true,
    "**/.dart_tool": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.fvm/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.rulers": [80, 100]
  },
  "[json]": {
    "editor.formatOnSave": false
  },
  "[yaml]": {
    "editor.formatOnSave": false
  }
}
